# База данни (RDS endpoint от CloudFormation output)
XML2EMMET_DB_HOST=xml2emmet-db.XXXX.us-east-1.rds.amazonaws.com
XML2EMMET_DB_USER=xml2emmet_admin
XML2EMMET_DB_PASS=your_secure_password
XML2EMMET_DB_PORT=3306
XML2EMMET_DB_NAME=xml2emmet

# S3 (bucket name от CloudFormation output)
XML2EMMET_S3_BUCKET=xml2emmet-history-123456789012
XML2EMMET_AWS_REGION=us-east-1

# Сесия и debug
XML2EMMET_SESSION_NAME=xml2emmet_sid
XML2EMMET_SECURE_COOKIE=0
XML2EMMET_DEBUG=0
